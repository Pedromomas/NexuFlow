# Public identifiers
FIREBASE_PROJECT_ID=nexuflow-dev
FIREBASE_WEB_API_KEY=replace-with-public-web-api-key
PUBLIC_API_BASE=https://api.example.com
PUBLIC_APP_RETURN_URL=https://example.com/conta

# Secrets: configure in Google Secret Manager / Cloud Run, never commit values.
MERCADO_PAGO_ACCESS_TOKEN=TEST-replace
MERCADO_PAGO_WEBHOOK_SECRET=replace
CODE_HASH_PEPPER=replace-with-32-random-bytes-base64
LICENSE_ED25519_PRIVATE_KEY=replace-with-32-random-bytes-base64

# false in Mercado Pago test mode; true only after production review.
MERCADO_PAGO_LIVE_MODE=false
ALLOWED_ORIGINS=https://tauri.localhost,http://tauri.localhost

