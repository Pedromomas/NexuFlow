{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexuFlow",
  "version": "1.5.8",
  "identifier": "com.nexuflow.booster",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npx ng build --base-href ./",
    "frontendDist": "../dist/nexuflow/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NexuFlow",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#07080c"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/nexus-engine"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
