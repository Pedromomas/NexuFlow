{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexuFlow",
  "version": "2.1.0-beta.3",
  "identifier": "com.nexuflow.booster",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist/nexuflow/browser"
  },
  "app": {
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data: blob:",
        "media-src": "'self'",
        "font-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "NexuFlow",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#07080c"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFOTEyNjlEQzYyNjUxNTEKUldSUlVTYkduU2FSYmk0Nkx1WnJHVVd0RHBZTXNjQUpTaHJ3MlN5UlVUUzNzdjFtT1BMTmUweUgK",
      "endpoints": [
        "https://github.com/Pedromomas/NexuFlow/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/nexus-engine"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
